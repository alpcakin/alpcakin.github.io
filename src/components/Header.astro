---
/**
 * tmux-style top bar: session name, numbered windows, host + local time.
 *
 * On the homepage windows are in-page anchors and the current one follows
 * scrolling (scripts/terminal.ts). Elsewhere they link back to the homepage
 * sections, and a window whose `match` covers the path is marked current.
 */
import { WINDOWS } from "@/constants";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = path === "/";

const windows = WINDOWS.map((window, i) => ({
  ...window,
  index: i + 1,
  href: isHome ? `#${window.id}` : window.href,
  current:
    !isHome &&
    (window.match ?? []).some(m => path === m || path.startsWith(`${m}/`)),
}));
---

<a href="#main-content" class="skip-link">Skip to content</a>

<header class="tmux" data-home={isHome ? "" : undefined}>
  <nav class="tmux-nav" aria-label="Sections">
    <a href="/" class="tmux-session" aria-label="Alp Çakın — home">[alp]</a>
    <ul class="tmux-windows">
      {
        windows.map(window => (
          <li>
            <a
              href={window.href}
              class="tmux-window"
              data-window={window.id}
              aria-current={window.current ? "page" : undefined}
            >
              <span class="tmux-window-index">{window.index}:</span>
              {window.label}
              <span class="tmux-flag" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="tmux-host">
    <span class="dim">alp@pécs</span>
    <time data-clock aria-label="Local time in Pécs">--:--</time>
  </p>
</header>

<style>
  .skip-link {
    position: absolute;
    left: 8px;
    top: -100px;
    z-index: 60;
    padding: 8px 14px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-weight: 700;
  }

  .skip-link:focus {
    top: 8px;
  }

  .tmux {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--bar-height);
    padding: 0 var(--gutter);
    background: var(--background);
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }

  .tmux-nav {
    display: flex;
    align-items: stretch;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }

  .tmux-session {
    flex: none;
    display: inline-flex;
    align-items: center;
    align-self: center;
    min-height: 32px;
    padding: 0 12px;
    background: var(--accent);
    color: var(--accent-foreground);
    font-weight: 700;
  }

  .tmux-session:hover {
    background: var(--foreground);
  }

  .tmux-windows {
    display: flex;
    align-items: stretch;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tmux-windows::-webkit-scrollbar {
    display: none;
  }

  .tmux-windows li {
    display: flex;
  }

  .tmux-window {
    display: inline-flex;
    align-items: center;
    min-height: var(--bar-height);
    padding: 0 6px 0 10px;
    white-space: nowrap;
    color: var(--foreground);
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .tmux-window:hover {
    background: var(--foreground);
    color: var(--background);
  }

  .tmux-window-index {
    color: var(--muted-foreground);
  }

  .tmux-window:hover .tmux-window-index {
    color: inherit;
  }

  .tmux-window[aria-current] {
    color: var(--accent);
  }

  .tmux-window[aria-current]:hover {
    color: var(--background);
  }

  /* tmux marks the current window with `*`; keep the slot so labels don't shift. */
  .tmux-flag {
    display: inline-block;
    width: 1ch;
  }

  .tmux-window[aria-current] .tmux-flag::before {
    content: "*";
  }

  /* `#` = activity: the pane is being written to (scripts/boot.ts). */
  .tmux-window[data-activity]:not([aria-current]) .tmux-flag::before {
    content: "#";
    color: var(--accent);
  }

  .tmux-host {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .tmux-host {
      display: none;
    }
  }
</style>
