---
/** Text share links for the current page, plus a copy-link button. */
import { SHARE_LINKS } from "@/constants";

const url = Astro.url.href;
---

<div class="share">
  <span class="dim">share:</span>
  <ul class="share-list">
    {
      SHARE_LINKS.map(link => (
        <li>
          <a
            href={`${link.href}${encodeURIComponent(url)}`}
            class="lk lk--ul"
            target="_blank"
            rel="noopener noreferrer"
            title={link.linkTitle}
          >
            {link.name}
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" class="share-copy" data-copy-url={url}>
        copy link
      </button>
    </li>
  </ul>
</div>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    font-size: 14px;
  }

  .share-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .share-copy {
    padding: 0;
    border: 0;
    background: none;
    color: var(--foreground);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
  }

  .share-copy:hover {
    background: var(--foreground);
    color: var(--background);
  }
</style>

<script>
  function initCopy() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-url]")
      .forEach(btn =>
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(
              btn.dataset.copyUrl ?? location.href
            );
            btn.textContent = "copied ✓";
          } catch {
            btn.textContent = "copy failed";
          }
          setTimeout(() => (btn.textContent = "copy link"), 1400);
        })
      );
  }

  document.addEventListener("astro:page-load", initCopy);
</script>
