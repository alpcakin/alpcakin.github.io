---
/** `[ :prev ]  page 1/3  [ :next ]` — rendered only when there is more than one page. */
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class="pager" aria-label="Pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="btn" rel="prev">
          :prev
        </a>
      ) : (
        <span class="btn pager-off" aria-disabled="true">
          :prev
        </span>
      )}
      <span class="pager-info">
        page {page.currentPage}/{page.lastPage}
      </span>
      {page.url.next ? (
        <a href={page.url.next} class="btn" rel="next">
          :next
        </a>
      ) : (
        <span class="btn pager-off" aria-disabled="true">
          :next
        </span>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
  }

  .pager-info {
    color: var(--muted-foreground);
  }

  .pager-off {
    opacity: 0.4;
    pointer-events: none;
  }
</style>
