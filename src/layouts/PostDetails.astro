---
/**
 * A blog post, opened like a file: `cat <slug>.md` in an article pane, with
 * an outline pane that tracks the current section and newer/older links.
 */
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Pane from "@/components/tui/Pane.astro";
import ShellPath from "@/components/ShellPath.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import { getPath } from "@/utils/getPath";
import { slugifyStr } from "@/utils/slugify";
import { postDates, readingMinutes } from "@/utils/postMeta";
import { SITE } from "@/config";

type Props = {
  post: CollectionEntry<"blog">;
  posts: CollectionEntry<"blog">[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings } = await render(post);

let ogImageUrl: string | undefined;

// Determine OG image source
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage; // Remote OG image (absolute URL)
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src; // Local asset
}

// Use dynamic OG image if enabled and no remote|local ogImage
if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

// Resolve OG image URL (or fallback to SITE.ogImage / default `og.png`)
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
  mode: "READ",
  hint: `${readingMinutes(post)} min read`,
};

const slug = getPath(post.id, post.filePath, false);
const fileName = `${slug.split("/").pop()}.md`;
const dates = postDates(post);
const minutes = readingMinutes(post);
const outline = headings.filter(h => h.depth >= 2 && h.depth <= 3);

/* Newer / older neighbours (`posts` is sorted newest first). */
const index = posts.findIndex(p => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : null;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : null;
---

<Layout {...layoutProps}>
  <main id="main-content" class="shell post-shell">
    <ShellPath
      segments={[
        { label: "posts", href: "/posts/" },
        { label: slug.split("/").pop() ?? slug },
      ]}
      cmd={`cat ${fileName}`}
    />

    <div class:list={["post-grid", { "post-grid--outline": outline.length }]}>
      {
        outline.length > 0 && (
          <aside class="post-aside" aria-label="Outline">
            <details class="outline" open data-outline>
              <summary class="outline-title">outline</summary>
              <ol class="outline-list">
                {outline.map(h => (
                  <li class:list={[`outline-depth-${h.depth}`]}>
                    <a
                      href={`#${h.slug}`}
                      class="outline-link"
                      data-outline-link
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </aside>
        )
      }

      <Pane
        as="article"
        id="article"
        title={fileName}
        level={0}
        focused
        class="post-pane"
      >
        <header class="post-head">
          <h1 class="post-title">{title}</h1>
          <p class="post-lede">{description}</p>
          <p class="post-meta">
            <time datetime={dates.publishedISO}>{dates.published}</time>
            {
              dates.updated && (
                <span>
                  {" "}
                  · updated{" "}
                  <time datetime={dates.updatedISO}>{dates.updated}</time>
                </span>
              )
            }
            <span> · {minutes} min read</span>
          </p>
          <ul class="post-tags" aria-label="Tags">
            {
              tags.map(tag => (
                <li>
                  <a href={`/tags/${slugifyStr(tag)}/`} class="lk">
                    #{tag}
                  </a>
                </li>
              ))
            }
          </ul>
        </header>

        <div class="prose post-body" id="article-body">
          <Content />
        </div>

        <footer class="post-foot">
          <p class="post-eof" aria-hidden="true">-- EOF --</p>
          <ShareLinks />
        </footer>
      </Pane>
    </div>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {newer ? (
            <a href={getPath(newer.id, newer.filePath)} class="post-nav-link">
              <span class="dim">← newer</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {older && (
            <a
              href={getPath(older.id, older.filePath)}
              class="post-nav-link post-nav-link--older"
            >
              <span class="dim">older →</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </main>
</Layout>

<style>
  /* Sized so the article pane hugs a 72ch measure next to the outline. */
  .post-shell {
    max-width: 1140px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--gap) + 4px);
    align-items: start;
  }

  @media (min-width: 1080px) {
    .post-grid--outline {
      grid-template-columns: minmax(0, 1fr) 280px;
    }

    .post-aside {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--bar-height) + 26px);
      max-height: calc(100svh - var(--bar-height) - 80px);
      overflow-y: auto;
    }

    .post-grid--outline :global(.post-pane) {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* ── Outline ── */
  .outline {
    border: 1px solid var(--border);
    font-size: 13px;
    line-height: 1.5;
  }

  .outline-title {
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--muted-foreground);
  }

  .outline-title::-webkit-details-marker {
    display: none;
  }

  .outline-title::before {
    content: "▸";
    content: "▸" / "";
    margin-right: 8px;
    color: var(--accent);
  }

  .outline[open] .outline-title::before {
    content: "▾";
    content: "▾" / "";
  }

  .outline[open] .outline-title {
    border-bottom: 1px solid var(--border);
  }

  .outline-list {
    margin: 0;
    padding: 8px 0;
    list-style: none;
  }

  .outline-link {
    display: block;
    padding: 5px 14px 5px 12px;
    border-left: 2px solid transparent;
    color: var(--soft-foreground);
    transition:
      background-color 0.12s ease,
      color 0.12s ease;
  }

  .outline-depth-3 .outline-link {
    padding-left: 26px;
    color: var(--muted-foreground);
  }

  .outline-link:hover {
    background: var(--hover);
    color: var(--foreground);
  }

  .outline-link[aria-current] {
    border-left-color: var(--accent);
    color: var(--accent);
  }

  /* ── Article ── */
  .post-head {
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1px dashed var(--border-strong);
  }

  .post-title {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground-strong);
  }

  .post-lede {
    margin: 16px 0 0;
    max-width: 64ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--soft-foreground);
  }

  .post-meta {
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--muted-foreground);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }

  .post-tags a {
    color: var(--accent);
  }

  .post-tags a:hover {
    color: var(--background);
  }

  .post-foot {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px dashed var(--border-strong);
  }

  .post-eof {
    margin: 0;
    color: var(--muted-foreground);
  }

  /* ── Newer / older ── */
  .post-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    transition:
      border-color 0.12s ease,
      background-color 0.12s ease;
  }

  .post-nav-link:hover {
    border-color: var(--accent);
    background: var(--hover);
  }

  .post-nav-link--older {
    text-align: right;
  }

  .post-nav-title {
    font-weight: 600;
    line-height: 1.4;
  }
</style>

<script>
  /** Turn each heading's `##` marker into a permalink. */
  function addHeadingAnchors(body: HTMLElement) {
    body
      .querySelectorAll<HTMLElement>("h2[id], h3[id], h4[id]")
      .forEach(heading => {
        if (heading.classList.contains("has-anchor")) return;
        const anchor = document.createElement("a");
        anchor.href = `#${heading.id}`;
        anchor.className = "heading-anchor";
        anchor.setAttribute(
          "aria-label",
          `Link to section: ${heading.textContent ?? ""}`
        );
        heading.prepend(anchor);
        heading.classList.add("has-anchor");
      });
  }

  let outlineController: AbortController | null = null;

  /** Highlight the outline entry of the section being read: the last heading
   *  above the upper third of the viewport, or the last one at the very end. */
  function trackOutline(body: HTMLElement) {
    outlineController?.abort();
    outlineController = new AbortController();
    const { signal } = outlineController;

    const links = new Map(
      Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-outline-link]")
      ).map(link => [decodeURIComponent(link.hash.slice(1)), link] as const)
    );
    const headings = Array.from(
      body.querySelectorAll<HTMLElement>("h2[id], h3[id]")
    ).filter(h => links.has(h.id));
    if (!headings.length) return;

    let frame = 0;
    const update = () => {
      frame = 0;
      const atEnd =
        window.scrollY + window.innerHeight >=
        document.documentElement.scrollHeight - 24;
      const line = window.innerHeight * 0.33;
      let current = headings[0];
      if (atEnd) current = headings[headings.length - 1];
      else
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top <= line) current = heading;
        }
      links.forEach((link, id) => {
        if (id === current.id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", schedule, { passive: true, signal });
    window.addEventListener("resize", schedule, { passive: true, signal });
    signal.addEventListener("abort", () => cancelAnimationFrame(frame));
    update();
  }

  /** Collapse the outline on narrow screens, where it sits above the article. */
  function fitOutline() {
    const outline =
      document.querySelector<HTMLDetailsElement>("[data-outline]");
    if (outline && window.matchMedia("(max-width: 1079px)").matches)
      outline.open = false;
  }

  function initPost() {
    // Drop listeners left over from a previous post (ClientRouter navigation).
    outlineController?.abort();
    const body = document.getElementById("article-body");
    if (!body) return;
    addHeadingAnchors(body);
    trackOutline(body);
    fitOutline();
  }

  document.addEventListener("astro:page-load", initPost);
</script>
