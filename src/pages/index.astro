---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Pane from "@/components/tui/Pane.astro";
import Prompt from "@/components/tui/Prompt.astro";
import WorkPane from "@/components/work/WorkPane.astro";
import PostList from "@/components/PostList.astro";
import BootIntro from "@/components/BootIntro.astro";
import portrait from "@/assets/images/alp-cakin.jpeg";
import { projects } from "@/data/projects";
import { experience, role, status, tagline } from "@/data/profile";
import { EMAIL, SOCIALS } from "@/constants";
import getSortedPosts from "@/utils/getSortedPosts";

const allPosts = getSortedPosts(await getCollection("blog"));
const latestPosts = allPosts.slice(0, 3);
const profileLinks = SOCIALS.filter(s =>
  ["github", "linkedin"].includes(s.name)
);
---

<Layout>
  <main id="main-content" class="shell">
    <!-- Row 1: who -->
    <div class="row">
      <Pane id="whoami" title="whoami" level={0} class="who" data-boot-root>
        <Prompt cmd="whoami" />
        <h1 class="name" data-boot="decode">
          Alp Çakın<span class="cursor" aria-hidden="true"></span>
        </h1>
        <p class="role" data-boot="type">{role}</p>
        <p class="tagline" data-boot="human">{tagline}</p>
        <p class="status" data-boot="print">
          <span class="accent" aria-hidden="true">●</span>
          {status}
        </p>
        <div class="actions" data-boot="print">
          <a href={`mailto:${EMAIL}`} class="btn btn--solid">mail me ⏎</a>
          {
            profileLinks.map(social => (
              <a
                href={social.href}
                class="lk lk--ul"
                target="_blank"
                rel="noopener noreferrer"
                title={social.linkTitle}
              >
                {social.name} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </Pane>

      <Pane
        id="about"
        index={1}
        title="about"
        class="about-pane"
        data-boot-root
      >
        <div class="about">
          <figure class="portrait" data-boot="scan">
            <Image
              src={portrait}
              alt="Portrait of Alp Çakın"
              widths={[120, 240]}
              sizes="120px"
              loading="lazy"
            />
          </figure>
          <div class="about-copy" data-boot="print">
            <p>
              Final-year Computer Science Engineering student at the University
              of Pécs, graduating in January 2027. I'm curious, eager to learn
              and always in the middle of learning something new — right now
              that's systems programming in <strong>Rust</strong>, where I write
              the core pieces myself.
            </p>
            <p>
              An internship at <strong>Doğuş Teknoloji</strong> put me hands-on with
              PostgreSQL, Docker, Kubernetes and OpenTelemetry. Day to day I work
              in Rust, C#/.NET, Python, TypeScript and SQL, and I keep up regular
              algorithm practice.
            </p>
          </div>
        </div>
        <Prompt cmd="git log --graph --oneline" tight />
        <ol class="log" data-boot="lines">
          {
            experience.map(entry => (
              <li class="log-entry">
                <span class="log-node" aria-hidden="true">
                  *
                </span>
                <span class="log-org">
                  {entry.href ? (
                    <a
                      href={entry.href}
                      class="lk lk--ul"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {entry.org} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    entry.org
                  )}
                </span>
                <span class="log-role">{entry.role}</span>
              </li>
            ))
          }
        </ol>
      </Pane>
    </div>

    <!-- Row 2: work -->
    <WorkPane projects={projects} index={2} />

    <!-- Row 3: writing + contact -->
    <div class="row">
      <Pane id="writing" index={3} title="writing" class="fill" data-boot-root>
        <p class="soft writing-intro" data-boot="type">
          I also write about economics and technology.
        </p>
        <PostList posts={latestPosts} variant="compact" />
        <p class="writing-more" data-boot="print">
          <a href="/posts/" class="lk lk--ul">all {allPosts.length} posts →</a>
        </p>
      </Pane>

      <Pane id="contact" index={4} title="contact" class="side" data-boot-root>
        <Prompt cmd="mail" tight />
        <p class="contact-mail" data-boot="decode">
          <a href={`mailto:${EMAIL}`} class="lk">{EMAIL}</a>
        </p>
        <p class="dim contact-note" data-boot="type">
          full-time roles · contract work
        </p>
        <ul class="contact-links" data-boot="lines">
          {
            SOCIALS.map(social => (
              <li>
                <a
                  href={social.href}
                  class="lk lk--ul"
                  target="_blank"
                  rel="noopener noreferrer"
                  title={social.linkTitle}
                >
                  {social.name} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </Pane>
    </div>
  </main>
  <BootIntro />
</Layout>

<style>
  /* ── Row 1: whoami + about side by side, stacked on small screens ── */
  :global(.pane.who) {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
  }

  :global(.pane.about-pane) {
    flex: 1.5 1 560px;
  }

  /* ── whoami ── */
  .name {
    margin: 14px 0 0;
    font-size: clamp(40px, 4.2vw, 60px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .role {
    margin: 14px 0 0;
    color: var(--accent);
    font-weight: 500;
  }

  .tagline {
    margin: 18px 0 0;
    max-width: 40ch;
    font-size: 17px;
    line-height: 1.6;
  }

  .status {
    display: flex;
    gap: 10px;
    margin: 20px 0 0;
    color: var(--soft-foreground);
  }

  /* Pinned to the bottom when the row is taller than whoami. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: auto;
    padding-top: 26px;
  }

  /* ── about ── */
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 24px;
    align-items: flex-start;
    margin-bottom: 24px;
  }

  .about-copy {
    flex: 1 1 260px;
    min-width: 0;
    max-width: 68ch;
  }

  .about-copy p {
    margin: 0 0 14px;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .about-copy strong {
    color: var(--foreground-strong);
    font-weight: 600;
  }

  /* Phosphor duotone; true colours on hover. */
  .portrait {
    position: relative;
    flex: 0 0 112px;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--accent);
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transform: scale(1.5);
    transform-origin: 43% 52%;
    filter: grayscale(1) contrast(1.15) brightness(0.95);
    mix-blend-mode: multiply;
    transition: filter 0.3s ease;
  }

  .portrait::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 2px,
      rgb(0 0 0 / 0.18) 3px
    );
    transition: opacity 0.3s ease;
  }

  .portrait:hover :global(img) {
    filter: none;
    mix-blend-mode: normal;
  }

  .portrait:hover::after {
    opacity: 0;
  }

  .log {
    display: grid;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .log-entry {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    line-height: 1.5;
  }

  .log-node {
    grid-row: span 2;
    color: var(--accent);
  }

  .log-org {
    font-weight: 600;
  }

  .log-role {
    color: var(--muted-foreground);
    font-size: 14px;
  }

  /* ── writing ── */
  .writing-intro {
    margin: 0 0 12px;
  }

  .writing-more {
    margin: 14px 0 0;
  }

  /* ── contact ── */
  .contact-mail {
    margin: 10px 0 0;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.3;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .contact-note {
    margin: 6px 0 0;
    font-size: 14px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait :global(img),
    .portrait::after {
      transition: none;
    }
  }
</style>
