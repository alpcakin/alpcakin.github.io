---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@/layouts/PostDetails.astro";
import getSortedPosts from "@/utils/getSortedPosts";

type Props = {
  post: CollectionEntry<"blogTr">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blogTr", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const allPosts = await getCollection("blogTr");
const sortedPosts = getSortedPosts(allPosts as unknown as CollectionEntry<"blog">[]);
---

<PostDetails post={post as unknown as CollectionEntry<"blog">} posts={sortedPosts} />
