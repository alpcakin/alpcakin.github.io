---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Pane from "@/components/tui/Pane.astro";
import ShellPath from "@/components/ShellPath.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

const posts = await getCollection("blog");

/* Most-used first, then alphabetical. */
const tags = getUniqueTags(posts)
  .map(({ tag, tagName }) => ({
    tag,
    tagName,
    count: getPostsByTag(posts, tag).length,
  }))
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<Layout title={`Tags | ${SITE.title}`} hint={`${tags.length} tags`}>
  <main id="main-content" class="shell list-shell">
    <ShellPath segments={[{ label: "tags" }]} cmd="ls" />

    <Pane id="writing" index={3} title="tags" level={0} focused>
      <header class="list-head">
        <h1 class="list-title">Tags</h1>
        <p class="list-intro">Every topic the essays touch.</p>
      </header>
      <ul class="tag-list">
        {
          tags.map(({ tag, tagName, count }) => (
            <li>
              <a href={`/tags/${tag}/`} class="tag-link">
                <span class="accent">#</span>
                {tagName}
                <span class="tag-count">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="list-more">
        <a href="/posts/" class="lk lk--ul">all posts</a>
      </p>
    </Pane>
  </main>
</Layout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-link {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    padding: 6px 10px;
    color: var(--foreground);
    transition: background-color 0.12s ease;
  }

  .tag-link:hover {
    background: var(--hover);
  }

  .tag-count {
    margin-left: 8px;
    color: var(--muted-foreground);
    font-size: 13px;
  }
</style>
